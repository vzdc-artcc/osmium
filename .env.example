# Local development env example only.
# Production templates live in .env.cutover.example and .env.prod.example.
BIND_ADDR=0.0.0.0:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/osmium
RUST_LOG=info,tower_http=debug
RUN_MIGRATIONS_ON_STARTUP=true
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
DEV_SEED_ENABLED=false
# Authenticated impersonation (spec 012) replaces the old dev login-as shortcut.
# Start via POST /api/v1/admin/impersonate/{cid} (SERVER_ADMIN only). Optional:
# IMPERSONATION_TTL_SECS (default 3600).
# IP rate limiting (spec 010). Enabled unless explicitly falsey. Limits are per
# source IP (resolved from X-Forwarded-For / X-Real-IP). A caller holding the
# `system_rate_limit.update` permission bypasses the limit.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MIN=1200
RATE_LIMIT_BURST=240
# Durable per-request IP tracking (spec 011). Buffered + batch-inserted off the
# request hot path; pruned after IP_REQUEST_LOG_RETENTION_DAYS.
IP_REQUEST_LOG_ENABLED=true
IP_REQUEST_LOG_RETENTION_DAYS=30
# Optional: IP_REQUEST_LOG_FLUSH_SECS (5), IP_REQUEST_LOG_BATCH_SIZE (500),
# IP_REQUEST_LOG_CHANNEL_CAPACITY (10000) default if unset.
# Optional bootstrap for the singleton server admin role.
# Set this to the VATSIM CID that should claim SERVER_ADMIN on first successful login.
OSMIUM_SERVER_ADMIN_CID=
VATSIM_DEV_MODE=true
VATSIM_CLIENT_ID=your-client-id
VATSIM_CLIENT_SECRET=your-client-secret
# Use one canonical local origin everywhere. Do not mix localhost and 127.0.0.1.
VATSIM_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/vatsim/callback
VATSIM_AUTHORIZE_URL=https://auth-dev.vatsim.net/oauth/authorize
VATSIM_TOKEN_URL=https://auth-dev.vatsim.net/oauth/token
VATSIM_USERINFO_URL=https://auth-dev.vatsim.net/api/user
VATSIM_SCOPE=full_name email vatsim_details country
# VATSIM dev mode should use post client authentication.
VATSIM_CLIENT_AUTH_METHOD=post
VATUSA_API_KEY=
VATUSA_FACILITY_ID=ZDC
VATUSA_API_BASE_URL=https://api.vatusa.net/v2
STATS_SYNC_ENABLED=true
ROSTER_SYNC_ENABLED=true
ROSTER_SYNC_INTERVAL_SECS=900
# Optional: EVENT_LIFECYCLE_ENABLED/_INTERVAL_SECS, LOA_EXPIRATION_ENABLED/
# _INTERVAL_SECS, SOLO_EXPIRATION_ENABLED/_INTERVAL_SECS, and
# APPOINTMENTS_SYNC_ENABLED/_INTERVAL_SECS all default to enabled with their
# own sensible intervals if unset — only set these to override.

# FAA preferred-routes ingest (self-hosted copy of the NFDC NASR PFR data).
# DISABLED by default — this is a new outbound integration; opt in explicitly.
# FAA_PREFERRED_ROUTES_SYNC_ENABLED=true
# FAA_PREFERRED_ROUTES_INTERVAL_SECS=86400   # checks daily; downloads only on a new cycle
# Optional overrides (defaults resolve the current 28-day NASR cycle URL):
# FAA_PREFERRED_ROUTES_URL=            # full URL override (skips cycle-date computation)
# FAA_PREFERRED_ROUTES_BASE_URL=https://nfdc.faa.gov/webContent/28DaySub/extra
# FAA_PREFERRED_ROUTES_CSV_NAME=PFR_RMT_FMT.csv

# Appointments sync (environment round-robin assignment, double-booking
# detection, 12h-advance warning emails) — TRAINING_ENVIRONMENTS is the
# comma-separated list of physical/virtual training rooms to rotate
# appointments across; BUFFER_TIME is the buffer (minutes) required between
# back-to-back appointments in the same environment.
TRAINING_ENVIRONMENTS=SBX1,SBX2
BUFFER_TIME=15

# File CDN / asset service
# Local development default. In Docker, prefer /app/storage/files.
FILE_STORAGE_ROOT=./storage/files
FILE_MAX_UPLOAD_BYTES=26214400
FILE_SIGNING_SECRET=change-me-in-production
# Optional: 64-char hex key for AES-256-GCM at-rest file encryption.
# Example generation: openssl rand -hex 32
FILE_ENCRYPTION_KEY_HEX=
CDN_BASE_URL=http://127.0.0.1:3000

# Email / AWS SES
EMAIL_ENABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
EMAIL_SES_ENDPOINT=
EMAIL_FROM_ADDRESS=
# Quote any value containing spaces — dotenvy silently stops parsing the
# rest of the file on an unquoted multi-word value.
EMAIL_FROM_NAME="Osmium"
EMAIL_REPLY_TO_ADDRESS=
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL_SECS=5
EMAIL_WORKER_BATCH_SIZE=25
EMAIL_UNSUBSCRIBE_BASE_URL=http://127.0.0.1:3000
EMAIL_UNSUBSCRIBE_SECRET=change-me-in-production

# VATSIM ATC-booking service token (server-side; proxies atc-bookings.vatsim.net)
ATC_BOOKING_TOKEN=
