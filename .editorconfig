root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,html,css,js}]
indent_size = 2

[*.md]
# A trailing double space is a hard line break in Markdown.
trim_trailing_whitespace = false

[{justfile,*.just}]
indent_size = 4
